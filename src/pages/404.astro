---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Page Not Found | AI Online Protractor"
  description="The requested page could not be found. Return to AI Online Protractor homepage."
  canonical="https://aionlineprotractor.com/404"
  currentPath="/404"
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-16 space-y-5">
    <div class="w-16 h-16 rounded-2xl bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 flex items-center justify-center font-mono font-bold text-2xl text-neutral-900 dark:text-white shadow-xs">
      404
    </div>
    <div class="space-y-2 max-w-md">
      <h1 class="text-2xl font-bold text-neutral-900 dark:text-white">Page Not Found</h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        The angle or page you were looking for doesn't exist or has been moved.
      </p>
    </div>
    <div class="flex items-center gap-3 pt-2">
      <a
        href="/"
        class="px-5 py-2.5 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shadow-xs"
      >
        Back to Protractor
      </a>
      <a
        href="/360-protractor"
        class="px-5 py-2.5 rounded-full border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 text-xs font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors"
      >
        Try 360° Tool
      </a>
    </div>
  </div>
</Layout>
