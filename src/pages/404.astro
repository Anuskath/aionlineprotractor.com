---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Angle Not Found | AI Online Protractor"
  description="The page you requested could not be found on AI Online Protractor. Return to our free online angle measurement tools."
  canonical="https://aionlineprotractor.com/404"
  robots="noindex, follow"
  currentPath="/404"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center space-y-8 min-h-[70vh] flex flex-col items-center justify-center">
    <!-- Mathematical 404 Visual Badge -->
    <div class="relative">
      <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 flex items-center justify-center font-mono font-black text-3xl sm:text-4xl text-neutral-950 dark:text-white shadow-xs">
        404°
      </div>
      <div class="absolute -top-2 -right-2 px-2.5 py-0.5 rounded-full bg-rose-500 text-white text-[10px] font-mono font-bold uppercase tracking-wider shadow-xs">
        Undefined
      </div>
    </div>

    <!-- Error Text -->
    <div class="space-y-2 max-w-lg">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">
        Angle Out of Bounds (404)
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        The coordinates or page you are trying to reach do not exist. Even in a 360° circle, 404° exceeds normal geometry bounds!
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs sm:text-sm font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shadow-xs"
      >
        <span>← Return to Home Protractor</span>
      </a>
      <a
        href="/360-protractor"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 text-xs sm:text-sm font-semibold hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors"
      >
        <span>Try 360° Protractor</span>
      </a>
    </div>

    <!-- Popular Tools Directory -->
    <div class="w-full max-w-xl pt-8 border-t border-neutral-200 dark:border-neutral-800 space-y-3 text-left">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 block text-center">
        Available Measurement Instruments
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
        <a href="/" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors flex items-center justify-between group">
          <span class="font-medium text-neutral-900 dark:text-white">180° Screen Protractor</span>
          <span class="text-neutral-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
        <a href="/360-protractor" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors flex items-center justify-between group">
          <span class="font-medium text-neutral-900 dark:text-white">360° Circular Protractor</span>
          <span class="text-neutral-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
        <a href="/measure-angle-image" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors flex items-center justify-between group">
          <span class="font-medium text-neutral-900 dark:text-white">AI Image & PDF Angle Finder</span>
          <span class="text-neutral-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
        <a href="/three-point-angle" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors flex items-center justify-between group">
          <span class="font-medium text-neutral-900 dark:text-white">3-Point Coordinate Calculator</span>
          <span class="text-neutral-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
