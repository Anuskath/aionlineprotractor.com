---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms of Service - AI Online Protractor"
  description="Terms and Conditions of Use for AI Online Protractor (aionlineprotractor.com)."
  canonical="https://aionlineprotractor.com/terms"
  currentPath="/terms"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="border-b border-neutral-200 dark:border-neutral-800 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">Terms of Service</h1>
      <p class="text-xs text-neutral-500 font-mono mt-2">Last updated: September 11, 2026</p>
    </div>

    <div class="prose prose-neutral dark:prose-invert max-w-none text-sm space-y-6 text-neutral-700 dark:text-neutral-300 leading-relaxed">
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-neutral-900 dark:text-white">1. Agreement to Terms</h2>
        <p>
          By accessing or using <strong>AI Online Protractor</strong> at <a href="https://aionlineprotractor.com" class="text-blue-600 underline">https://aionlineprotractor.com</a>, you agree to be bound by these Terms of Service. If you disagree with any part of these terms, you may not access the service.
        </p>
      </section>

      <section class="space-y-3">
