---
// Comprehensive Angle Knowledge Base & FAQs for SEO and AdSense High-Value Content
const angleTypes = [
  {
    name: 'Acute Angle',
    range: '0° < θ < 90°',
    description: 'An angle that is smaller than a right angle. Common in roof trusses, knife blades, and triangular bracing.',
    color: 'emerald',
  },
  {
    name: 'Right Angle',
    range: 'θ = 90° (π/2 rad)',
    description: 'A quarter circle perpendicular angle formed by two perpendicular lines. Essential in architectural framing and carpenter squares.',
    color: 'blue',
  },
  {
    name: 'Obtuse Angle',
    range: '90° < θ < 180°',
    description: 'An angle greater than 90° but less than 180°. Frequently seen in recliners, obtuse roof pitches, and road forks.',
    color: 'amber',
  },
  {
    name: 'Straight Angle',
    range: 'θ = 180° (π rad)',
    description: 'A straight line formed by two opposite collinear rays. Represents a complete half rotation.',
    color: 'purple',
  },
  {
    name: 'Reflex Angle',
    range: '180° < θ < 360°',
    description: 'An angle greater than a straight angle but less than a full circle. Common when measuring exterior building corners.',
    color: 'rose',
  },
  {
    name: 'Full Rotation',
    range: 'θ = 360° (2π rad)',
    description: 'A complete circular rotation where the terminal ray coincides with the initial ray.',
    color: 'neutral',
  },
];

const faqs = [
  {
    q: 'How do I use this online protractor to measure an angle on my screen?',
    a: 'Simply drag the black center vertex to align with the vertex of the angle you wish to measure. Then drag the green ray (Ray 1) along the baseline of the angle, and drag the blue ray (Ray 2) along the second arm. The exact angle readout in degrees, radians, and slope is displayed in real-time.',
  },
  {
    q: 'Can I upload an image or blueprint to measure angles directly on it?',
    a: 'Yes! Click the "Upload Image" button in the toolbar to upload any JPG, PNG, WebP, or SVG file. Your image will appear directly beneath the interactive protractor. Use the transparency slider to adjust the protractor opacity so you can trace drawing angles with sub-pixel precision.',
  },
  {
    q: 'What is the difference between a 180° and 360° protractor?',
    a: 'A standard 180-degree protractor is a semi-circle tool primarily used for acute, right, and obtuse angles. A 360-degree protractor is a full circular instrument that allows seamless measurement of reflex angles and full-circle bearings without needing to calculate supplements.',
  },
  {
    q: 'Is this online protractor accurate on mobile phones and tablets?',
    a: 'Yes, our online protractor is built with responsive SVG vector geometry and full multi-touch pointer support. It scales smoothly to any screen resolution, from high-density Retina displays to mobile phones and iPads.',
  },
  {
    q: 'How do complementary and supplementary angles work?',
    a: 'Two angles are complementary if their sum equals 90 degrees (e.g., 30° and 60°). Two angles are supplementary if their sum equals 180 degrees (e.g., 45° and 135°). Our live inspector automatically computes both values for you instantly.',
  },
];
---

<section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16 border-t border-neutral-200 dark:border-neutral-800">
  <!-- Section 1: Types of Angles Grid -->
  <div>
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 block mb-2">
        Geometry Reference Guide
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">
        Classification of Angles
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
        Angles are categorized by their geometric degree measurement relative to straight and perpendicular lines.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {angleTypes.map((item) => (
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-xs flex flex-col justify-between hover:border-neutral-300 dark:hover:border-neutral-700 transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-bold text-lg text-neutral-900 dark:text-white">{item.name}</h3>
              <span class="font-mono text-sm px-3 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 font-semibold">
                {item.range}
              </span>
            </div>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Section 2: Real-World Use Cases -->
  <div class="bg-neutral-100/60 dark:bg-neutral-900/60 rounded-3xl p-8 sm:p-12 border border-neutral-200 dark:border-neutral-800">
    <div class="max-w-3xl mb-8">
      <span class="text-xs sm:text-sm font-mono font-semibold uppercase tracking-wider text-neutral-500 block mb-1">
        Practical Applications
      </span>
      <h3 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">
        Who Uses An Online Protractor?
      </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-sm">
      <div class="space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
          📐
        </div>
        <h4 class="font-semibold text-neutral-900 dark:text-white text-base">Students & Teachers</h4>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm">
          Verify geometry homework, measure triangle angles on digital PDF worksheets, and demonstrate angle principles on interactive smartboards.
        </p>
      </div>

      <div class="space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
          🏛️
        </div>
        <h4 class="font-semibold text-neutral-900 dark:text-white text-base">Architects & Drafters</h4>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm">
          Check roof pitches, staircase slope gradients, and verify CAD elevation angles directly on uploaded blueprint screenshots.
        </p>
      </div>

      <div class="space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg">
          🎨
        </div>
        <h4 class="font-semibold text-neutral-900 dark:text-white text-base">Designers & Artists</h4>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm">
          Align perspective guidelines, compute isometric grid lines (30°/60°), and balance typography angles in illustrations.
        </p>
      </div>

      <div class="space-y-2.5">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">
          🪚
        </div>
        <h4 class="font-semibold text-neutral-900 dark:text-white text-base">DIY & Woodworking</h4>
        <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm">
          Calculate miter saw angles, measure joint bevels from digital photos, and find true bevel angles before making physical cuts.
        </p>
      </div>
    </div>
  </div>

  <!-- Section 3: FAQ Accordion for Rich Snippet SEO -->
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <span class="text-xs sm:text-sm font-mono font-semibold uppercase tracking-wider text-neutral-500 block mb-1">
        Help & Guidance
      </span>
      <h3 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">
        Frequently Asked Questions
      </h3>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 transition-all [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-base sm:text-lg text-neutral-900 dark:text-neutral-100 gap-4">
            <span>{faq.q}</span>
            <span class="transition-transform group-open:rotate-180 text-neutral-400 text-sm">▼</span>
          </summary>
          <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-3 pt-3 border-t border-neutral-100 dark:border-neutral-800 leading-relaxed">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
