    // Fallback file input change (native camera shutter on phone)
    cameraFileFallback?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        if (event.target?.result) {
          applyLoadedImage(event.target.result, '📸 Photo loaded! Click "✨ AI Auto-Detect Angle" or drag handles to measure.');
        }
      };
      reader.readAsDataURL(file);
    });

    clearImgBtn?.addEventListener('click', () => {
      if (uploadedPreviewImg) {
        uploadedPreviewImg.src = '';
        uploadedPreviewImg.classList.add('hidden');
        clearImgBtn?.classList.add('hidden');
        autoDetectBtn?.classList.add('hidden');
      }
      if (pdfControls) {
        pdfControls.classList.add('hidden');
        pdfControls.classList.remove('flex');
      }
      currentPdfDoc = null;
      if (imageLoader) imageLoader.value = '';
      if (cameraFileFallback) cameraFileFallback.value = '';
    });

    // In-Browser Computer Vision Diagram Angle Analyzer
    function analyzeDiagramForAngle(img) {
      const canvas = document.createElement('canvas');
      const W = 500;
      const H = 350;
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;

      ctx.drawImage(img, 0, 0, W, H);
      const imgData = ctx.getImageData(0, 0, W, H);
      const data = imgData.data;

      // 1. Calculate luminance and background polarity
      let totalLum = 0;
      const sampleStep = 8;
      let samples = 0;
      for (let i = 0; i < data.length; i += 4 * sampleStep) {
        totalLum += 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
        samples++;
      }
      const avgLum = totalLum / samples;
      const isLightBg = avgLum > 128;

      // 2. Binary stroke edge mask
      const binary = new Uint8Array(W * H);
      const threshold = isLightBg ? Math.min(185, avgLum - 25) : Math.max(75, avgLum + 25);

      for (let y = 1; y < H - 1; y++) {
        for (let x = 1; x < W - 1; x++) {
          const idx = (y * W + x) * 4;
          const lum = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
          binary[y * W + x] = (isLightBg ? (lum < threshold) : (lum > threshold)) ? 1 : 0;
        }
      }

      // 3. Radial Ray Cast Angle Detection from Candidate Vertices
      const rayDirections = 36;
      const maxDist = 75;
      let bestCandidate = null;
      let maxScore = -1;

      const gridStep = 4;
      for (let y = 35; y < H - 35; y += gridStep) {
        for (let x = 35; x < W - 35; x += gridStep) {
          if (binary[y * W + x] !== 1) continue;

          const rayScores = new Float32Array(rayDirections);
          for (let r = 0; r < rayDirections; r++) {
            const rad = (r * 10 * Math.PI) / 180;
            const cos = Math.cos(rad);
            const sin = Math.sin(rad);

            let hitCount = 0;
            for (let d = 6; d <= maxDist; d += 2) {
              const qx = Math.round(x + d * cos);
              const qy = Math.round(y + d * sin);
              if (qx < 0 || qx >= W || qy < 0 || qy >= H) break;
              if (binary[qy * W + qx] === 1) {
                hitCount++;
              } else {
                let nearHit = false;
                for (let dy = -1; dy <= 1; dy++) {
                  for (let dx = -1; dx <= 1; dx++) {
                    const nqy = qy + dy;
                    const nqx = qx + dx;
                    if (nqx >= 0 && nqx < W && nqy >= 0 && nqy < H && binary[nqy * W + nqx] === 1) {
                      nearHit = true;
                      break;
                    }
                  }
                  if (nearHit) break;
                }
                if (nearHit) hitCount++;
                else if (d > 14) break;
              }
            }
            rayScores[r] = hitCount;
          }

          let peak1 = -1, peakScore1 = 0;
          let peak2 = -1, peakScore2 = 0;

          for (let r = 0; r < rayDirections; r++) {
            if (rayScores[r] > peakScore1) {
              peakScore1 = rayScores[r];
              peak1 = r;
            }
          }

          if (peakScore1 < 8) continue;

          for (let r = 0; r < rayDirections; r++) {
            const angleDiff = Math.abs(r - peak1) * 10;
            const circDiff = Math.min(angleDiff, 360 - angleDiff);
            if (circDiff >= 18 && circDiff <= 170) {
              if (rayScores[r] > peakScore2) {
                peakScore2 = rayScores[r];
                peak2 = r;
              }
            }
          }

          if (peakScore2 < 7) continue;

          const angleSeparation = Math.min(Math.abs(peak2 - peak1) * 10, 360 - Math.abs(peak2 - peak1) * 10);
          const score = (peakScore1 + peakScore2) * Math.sin((angleSeparation * Math.PI) / 180);

          if (score > maxScore) {
            maxScore = score;
            bestCandidate = {
              x,
              y,
              ray1Angle: peak1 * 10,
              ray2Angle: peak2 * 10,
              score,
            };
          }
        }
      }

      if (!bestCandidate) return null;

      const svgX = (bestCandidate.x / W) * 1000;
      const svgY = (bestCandidate.y / H) * 700;

      // Invert Y angle to SVG geometry
      const mappedRay1 = (360 - bestCandidate.ray1Angle + 360) % 360;
      const mappedRay2 = (360 - bestCandidate.ray2Angle + 360) % 360;

      return {
        vertexX: Math.round(svgX),
        vertexY: Math.round(svgY),
        ray1Angle: Math.round(mappedRay1),
        ray2Angle: Math.round(mappedRay2),
      };
    }

    // Auto Detect Button Handler
    autoDetectBtn?.addEventListener('click', () => {
      if (!uploadedPreviewImg || !uploadedPreviewImg.src || uploadedPreviewImg.classList.contains('hidden')) {
        alert('Please upload an image or PDF first!');
        return;
      }

      const scanner = document.getElementById('ai-scanner-line');
      const toast = document.getElementById('ai-status-toast');
      const toastMsg = document.getElementById('ai-toast-msg');

      if (scanner) scanner.classList.remove('hidden');
      if (autoDetectSpinner) autoDetectSpinner.classList.remove('hidden');
      if (autoDetectIcon) autoDetectIcon.classList.add('hidden');
      if (autoDetectText) autoDetectText.textContent = 'Scanning diagram...';

      let pos = 0;
      const sweep = setInterval(() => {
        pos = (pos + 6) % 100;
        if (scanner) scanner.style.top = `${pos}%`;
      }, 40);

      setTimeout(() => {
        clearInterval(sweep);
        if (scanner) scanner.classList.add('hidden');
        if (autoDetectSpinner) autoDetectSpinner.classList.add('hidden');
        if (autoDetectIcon) autoDetectIcon.classList.remove('hidden');
        if (autoDetectText) autoDetectText.textContent = 'AI Auto-Detect Angle';

        const result = analyzeDiagramForAngle(uploadedPreviewImg);
        if (result) {
          origin.x = Math.max(100, Math.min(900, result.vertexX));
          origin.y = Math.max(100, Math.min(600, result.vertexY));
          angle1 = result.ray1Angle;
          angle2 = result.ray2Angle;
          renderProtractor();

          if (toast && toastMsg) {
            const deg = getMeasuredAngle().toFixed(1);
            toastMsg.textContent = `✨ Angle detected: ${deg}°! Drag handles to fine-tune.`;
            toast.classList.remove('hidden');
            toast.classList.add('flex');
            setTimeout(() => {
              toast.classList.add('hidden');
              toast.classList.remove('flex');
            }, 4500);
          }
        } else {
          // Centered fallback
          origin.x = 500;
          origin.y = mode === '360' ? 350 : 440;
          renderProtractor();

          if (toast && toastMsg) {
            toastMsg.textContent = 'Lines detected! Centered protractor on diagram — drag handles to align.';
            toast.classList.remove('hidden');
            toast.classList.add('flex');
            setTimeout(() => {
              toast.classList.add('hidden');
              toast.classList.remove('flex');
            }, 4000);
          }
        }
      }, 700);
    });

    // Helper: Normalize angle to 0..360
    function normalizeAngle(a) {
      let ang = a % 360;
      if (ang < 0) ang += 360;
      return ang;
    }

    // Convert degrees to SVG coordinate from center
    function polarToCartesian(centerX, centerY, rad, angleInDegrees) {
      const angleInRadians = (angleInDegrees * Math.PI) / 180.0;
      return {
        x: centerX + rad * Math.cos(angleInRadians),
        y: centerY - rad * Math.sin(angleInRadians), // SVG y is inverted
      };
    }

    // Calculate current measured angle between Ray 1 and Ray 2
    function getMeasuredAngle() {
      let diff = angle2 - angle1;
      if (mode === '180') {
        let a = Math.abs(diff) % 360;
        if (a > 180) a = 360 - a;
        return a;
      } else {
        let a = diff % 360;
        if (a < 0) a += 360;
        return a;
      }
    }

    // Draw full SVG protractor
    function renderProtractor() {
      if (!group) return;
      group.innerHTML = '';

      const isDark = document.documentElement.classList.contains('dark');
      const is360 = mode === '360';
      const measuredAngle = getMeasuredAngle();
      const currentRadius = radius;

      // Theme-adaptive colors
      const discBg = isDark ? 'rgba(18, 18, 20, 0.88)' : 'rgba(255, 255, 255, 0.90)';
      const discBorder = isDark ? '#3f3f46' : '#a3a3a3';
      const majorTickColor = isDark ? '#f4f4f5' : '#171717';
      const minorTickColor = isDark ? '#71717a' : '#737373';
      const majorTextColor = isDark ? '#ffffff' : '#171717';
      const innerTextColor = isDark ? '#a1a1aa' : '#525252';
      const centerFill = isDark ? '#ffffff' : '#171717';
      const centerStroke = isDark ? '#18181b' : '#ffffff';

      // 1. Semi-transparent background disc / semicircle
      let bgPath = '';
      if (is360) {
        bgPath = `M ${origin.x + currentRadius} ${origin.y} A ${currentRadius} ${currentRadius} 0 1 0 ${origin.x - currentRadius} ${origin.y} A ${currentRadius} ${currentRadius} 0 1 0 ${origin.x + currentRadius} ${origin.y} Z`;
      } else {
        bgPath = `M ${origin.x - currentRadius} ${origin.y} A ${currentRadius} ${currentRadius} 0 0 1 ${origin.x + currentRadius} ${origin.y} Z`;
      }

      const pathElem = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      pathElem.setAttribute('d', bgPath);
      pathElem.setAttribute('fill', discBg);
      pathElem.setAttribute('stroke', discBorder);
      pathElem.setAttribute('stroke-width', '1.5');
      pathElem.setAttribute('opacity', opacity.toString());
      pathElem.setAttribute('style', 'backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);');
      group.appendChild(pathElem);

      // 2. Degree ticks and labels
      const maxDegree = is360 ? 360 : 180;
      const step = 1;

      for (let deg = 0; deg <= maxDegree; deg += step) {
        const isTen = deg % 10 === 0;
        const isFive = deg % 5 === 0;
        const tickLength = isTen ? 18 : isFive ? 12 : 6;

        // Outer ticks
        const pOuter = polarToCartesian(origin.x, origin.y, currentRadius, deg);
        const pInner = polarToCartesian(origin.x, origin.y, currentRadius - tickLength, deg);

        const tick = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        tick.setAttribute('x1', pOuter.x.toString());
        tick.setAttribute('y1', pOuter.y.toString());
        tick.setAttribute('x2', pInner.x.toString());
        tick.setAttribute('y2', pInner.y.toString());
        tick.setAttribute('stroke', isTen ? majorTickColor : minorTickColor);
        tick.setAttribute('stroke-width', isTen ? '1.5' : '1');
        group.appendChild(tick);

        // Degree numbers on every 10th tick
        if (isTen && deg % 10 === 0) {
          const pText = polarToCartesian(origin.x, origin.y, currentRadius - 32, deg);
          const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          text.setAttribute('x', pText.x.toString());
          text.setAttribute('y', (pText.y + 5).toString());
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('font-size', '13.5');
          text.setAttribute('font-family', 'ui-monospace, monospace');
          text.setAttribute('font-weight', '700');
          text.setAttribute('fill', majorTextColor);
          text.setAttribute('style', 'user-select: none; pointer-events: none;');
          text.textContent = deg.toString();
          group.appendChild(text);

          // Inner reversed scale for 180 mode (classic protractor dual scale)
          if (!is360 && deg >= 0 && deg <= 180) {
            const innerDeg = 180 - deg;
            const pTextInner = polarToCartesian(origin.x, origin.y, currentRadius - 52, deg);
            const textInner = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            textInner.setAttribute('x', pTextInner.x.toString());
            textInner.setAttribute('y', (pTextInner.y + 4).toString());
            textInner.setAttribute('text-anchor', 'middle');
            textInner.setAttribute('font-size', '11');
            textInner.setAttribute('font-family', 'ui-monospace, monospace');
            textInner.setAttribute('font-weight', '600');
            textInner.setAttribute('fill', innerTextColor);
            textInner.setAttribute('style', 'user-select: none; pointer-events: none;');
            textInner.textContent = innerDeg.toString();
            group.appendChild(textInner);
          }
        }
      }

      // 3. Highlighted Angle Sector Wedge (Pie shape between Ray 1 and Ray 2)
      const pRay1 = polarToCartesian(origin.x, origin.y, currentRadius * 0.95, angle1);
      const pRay2 = polarToCartesian(origin.x, origin.y, currentRadius * 0.95, angle2);

      const sectorArcRadius = currentRadius * 0.35;
      const pArc1 = polarToCartesian(origin.x, origin.y, sectorArcRadius, angle1);
      const pArc2 = polarToCartesian(origin.x, origin.y, sectorArcRadius, angle2);

      // Arc flag
      let arcDiff = angle2 - angle1;
      if (arcDiff < 0) arcDiff += 360;
      const largeArcFlag = arcDiff > 180 ? 1 : 0;

      const sectorPath = `M ${origin.x} ${origin.y} L ${pArc1.x} ${pArc1.y} A ${sectorArcRadius} ${sectorArcRadius} 0 ${largeArcFlag} 0 ${pArc2.x} ${pArc2.y} Z`;
      const sectorElem = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      sectorElem.setAttribute('d', sectorPath);
      sectorElem.setAttribute('fill', isDark ? 'rgba(59, 130, 246, 0.28)' : 'rgba(59, 130, 246, 0.22)');
      sectorElem.setAttribute('stroke', '#3b82f6');
      sectorElem.setAttribute('stroke-width', '1.5');
      sectorElem.setAttribute('style', 'pointer-events: none;');
      group.appendChild(sectorElem);

      // 4. Ray 1 (Base Line - Emerald/Green)
      // Invisible wide hit line for mobile touch along ray length
      const ray1HitLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ray1HitLine.setAttribute('x1', origin.x.toString());
      ray1HitLine.setAttribute('y1', origin.y.toString());
      ray1HitLine.setAttribute('x2', pRay1.x.toString());
      ray1HitLine.setAttribute('y2', pRay1.y.toString());
      ray1HitLine.setAttribute('stroke', 'transparent');
      ray1HitLine.setAttribute('stroke-width', '36');
      ray1HitLine.setAttribute('data-handle', 'ray1');
      ray1HitLine.setAttribute('style', 'cursor: grab; pointer-events: stroke; -webkit-tap-highlight-color: transparent;');
      group.appendChild(ray1HitLine);

      // Visual Ray 1 Line
      const ray1Line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ray1Line.setAttribute('x1', origin.x.toString());
      ray1Line.setAttribute('y1', origin.y.toString());
      ray1Line.setAttribute('x2', pRay1.x.toString());
      ray1Line.setAttribute('y2', pRay1.y.toString());
      ray1Line.setAttribute('stroke', '#10b981');
      ray1Line.setAttribute('stroke-width', '3.5');
      ray1Line.setAttribute('stroke-linecap', 'round');
      ray1Line.setAttribute('style', 'pointer-events: none;');
      group.appendChild(ray1Line);

      // Invisible Hit Target for Ray 1 Handle (enlarged for mobile thumbs)
      const ray1HitCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      ray1HitCircle.setAttribute('cx', pRay1.x.toString());
      ray1HitCircle.setAttribute('cy', pRay1.y.toString());
      ray1HitCircle.setAttribute('r', '38');
      ray1HitCircle.setAttribute('fill', 'transparent');
      ray1HitCircle.setAttribute('data-handle', 'ray1');
      ray1HitCircle.setAttribute('style', 'cursor: grab; pointer-events: all; -webkit-tap-highlight-color: transparent;');
      group.appendChild(ray1HitCircle);

      // Visual Ray 1 Handle
      const ray1Handle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      ray1Handle.setAttribute('cx', pRay1.x.toString());
      ray1Handle.setAttribute('cy', pRay1.y.toString());
      ray1Handle.setAttribute('r', activeDrag === 'ray1' ? '14' : '11');
      ray1Handle.setAttribute('fill', '#10b981');
      ray1Handle.setAttribute('stroke', isDark ? '#18181b' : '#ffffff');
      ray1Handle.setAttribute('stroke-width', '2.5');
      ray1Handle.setAttribute('style', 'pointer-events: none; transition: r 0.15s ease;');
      ray1Handle.setAttribute('class', 'drop-shadow-md');
      group.appendChild(ray1Handle);

      // 5. Ray 2 (Measuring Arm - Blue)
      // Invisible wide hit line for mobile touch along ray length
      const ray2HitLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ray2HitLine.setAttribute('x1', origin.x.toString());
      ray2HitLine.setAttribute('y1', origin.y.toString());
      ray2HitLine.setAttribute('x2', pRay2.x.toString());
      ray2HitLine.setAttribute('y2', pRay2.y.toString());
      ray2HitLine.setAttribute('stroke', 'transparent');
      ray2HitLine.setAttribute('stroke-width', '36');
      ray2HitLine.setAttribute('data-handle', 'ray2');
      ray2HitLine.setAttribute('style', 'cursor: grab; pointer-events: stroke; -webkit-tap-highlight-color: transparent;');
      group.appendChild(ray2HitLine);

      // Visual Ray 2 Line
      const ray2Line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ray2Line.setAttribute('x1', origin.x.toString());
      ray2Line.setAttribute('y1', origin.y.toString());
      ray2Line.setAttribute('x2', pRay2.x.toString());
      ray2Line.setAttribute('y2', pRay2.y.toString());
      ray2Line.setAttribute('stroke', '#3b82f6');
      ray2Line.setAttribute('stroke-width', '3.5');
      ray2Line.setAttribute('stroke-linecap', 'round');
      ray2Line.setAttribute('style', 'pointer-events: none;');
      group.appendChild(ray2Line);

      // Invisible Hit Target for Ray 2 Handle (enlarged for mobile thumbs)
      const ray2HitCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      ray2HitCircle.setAttribute('cx', pRay2.x.toString());
      ray2HitCircle.setAttribute('cy', pRay2.y.toString());
      ray2HitCircle.setAttribute('r', '38');
      ray2HitCircle.setAttribute('fill', 'transparent');
      ray2HitCircle.setAttribute('data-handle', 'ray2');
      ray2HitCircle.setAttribute('style', 'cursor: grab; pointer-events: all; -webkit-tap-highlight-color: transparent;');
      group.appendChild(ray2HitCircle);

      // Visual Ray 2 Handle
      const ray2Handle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      ray2Handle.setAttribute('cx', pRay2.x.toString());
      ray2Handle.setAttribute('cy', pRay2.y.toString());
      ray2Handle.setAttribute('r', activeDrag === 'ray2' ? '14' : '11');
      ray2Handle.setAttribute('fill', '#3b82f6');
      ray2Handle.setAttribute('stroke', isDark ? '#18181b' : '#ffffff');
      ray2Handle.setAttribute('stroke-width', '2.5');
      ray2Handle.setAttribute('style', 'pointer-events: none; transition: r 0.15s ease;');
      ray2Handle.setAttribute('class', 'drop-shadow-md');
      group.appendChild(ray2Handle);

      // 6. Center Origin Vertex handle
      // Invisible Hit Target for Center Handle
      const centerHitCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      centerHitCircle.setAttribute('cx', origin.x.toString());
      centerHitCircle.setAttribute('cy', origin.y.toString());
      centerHitCircle.setAttribute('r', '40');
      centerHitCircle.setAttribute('fill', 'transparent');
      centerHitCircle.setAttribute('data-handle', 'center');
      centerHitCircle.setAttribute('style', 'cursor: move; pointer-events: all; -webkit-tap-highlight-color: transparent;');
      group.appendChild(centerHitCircle);

      // Visual Center Handle
      const centerHandle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      centerHandle.setAttribute('cx', origin.x.toString());
      centerHandle.setAttribute('cy', origin.y.toString());
      centerHandle.setAttribute('r', activeDrag === 'center' ? '13' : '10');
      centerHandle.setAttribute('fill', centerFill);
      centerHandle.setAttribute('stroke', centerStroke);
      centerHandle.setAttribute('stroke-width', '2.5');
      centerHandle.setAttribute('style', 'pointer-events: none; transition: r 0.15s ease;');
      centerHandle.setAttribute('class', 'drop-shadow-md');
      group.appendChild(centerHandle);

      // Center crosshair ring
      const centerRing = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      centerRing.setAttribute('cx', origin.x.toString());
      centerRing.setAttribute('cy', origin.y.toString());
      centerRing.setAttribute('r', '22');
      centerRing.setAttribute('fill', 'none');
      centerRing.setAttribute('stroke', isDark ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.2)');
      centerRing.setAttribute('stroke-width', '1');
      centerRing.setAttribute('stroke-dasharray', '2,2');
      centerRing.setAttribute('style', 'pointer-events: none;');
      group.appendChild(centerRing);

      // Update Live Readout Elements
      updateReadouts(measuredAngle);
    }

    function updateReadouts(deg) {
      const roundedDeg = deg.toFixed(1);
      if (readoutDeg) readoutDeg.textContent = roundedDeg;

      // Radian
      const rad = (deg * Math.PI) / 180;
      if (readoutRad) readoutRad.textContent = `${rad.toFixed(3)} rad`;

      // Gradian
      const grad = (deg * 400) / 360;
      if (readoutGrad) readoutGrad.textContent = `${grad.toFixed(1)} grad`;

      // Supplementary (180 - deg)
      const supp = Math.max(0, 180 - deg);
      if (readoutSupp) readoutSupp.textContent = `${supp.toFixed(1)}°`;

      // Complementary (90 - deg)
      const comp = deg <= 90 ? (90 - deg).toFixed(1) + '°' : 'None (>90°)';
      if (readoutComp) readoutComp.textContent = comp;

      // Reflex (360 - deg)
      const reflex = (360 - deg).toFixed(1);
      if (readoutReflex) readoutReflex.textContent = `${reflex}°`;

      // Slope % = tan(deg) * 100
      if (deg === 90 || deg === 270) {
        if (readoutSlope) readoutSlope.textContent = 'Infinite (Vertical)';
      } else {
        const slope = Math.abs(Math.tan(rad) * 100);
        if (readoutSlope) readoutSlope.textContent = `${slope.toFixed(1)}%`;
      }

      // Classification Badge
      let classification = 'Acute Angle';
      let badgeStyle = 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200 dark:border-blue-900';

      if (deg === 0) {
        classification = 'Zero Angle (0°)';
      } else if (deg > 0 && deg < 90) {
        classification = 'Acute Angle (<90°)';
      } else if (Math.abs(deg - 90) < 0.2) {
        classification = 'Right Angle (90°)';
        badgeStyle = 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900';
      } else if (deg > 90 && deg < 180) {
        classification = 'Obtuse Angle (90°-180°)';
        badgeStyle = 'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-900';
      } else if (Math.abs(deg - 180) < 0.2) {
        classification = 'Straight Angle (180°)';
        badgeStyle = 'bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border-purple-200 dark:border-purple-900';
      } else if (deg > 180 && deg < 360) {
        classification = 'Reflex Angle (180°-360°)';
        badgeStyle = 'bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border-rose-200 dark:border-rose-900';
      } else if (Math.abs(deg - 360) < 0.2) {
        classification = 'Full Rotation (360°)';
      }

      if (classificationBadge) {
        classificationBadge.textContent = classification;
        classificationBadge.className = `px-2.5 py-0.5 rounded-full text-xs font-medium border ${badgeStyle}`;
      }
    }

    // Convert SVG mouse/touch event coordinates to SVG viewbox coords
    function getSvgCoordinates(e) {
      if (!svg) return { x: 0, y: 0 };
      const pt = svg.createSVGPoint();
      if (e.touches && e.touches.length > 0) {
        pt.x = e.touches[0].clientX;
        pt.y = e.touches[0].clientY;
      } else if (e.changedTouches && e.changedTouches.length > 0) {
        pt.x = e.changedTouches[0].clientX;
        pt.y = e.changedTouches[0].clientY;
      } else {
        pt.x = e.clientX;
        pt.y = e.clientY;
      }
      const ctm = svg.getScreenCTM();
      if (ctm) {
        return pt.matrixTransform(ctm.inverse());
      }
      return { x: 0, y: 0 };
    }

    // Pointer Event Listeners
    function onPointerDown(e) {
      const target = e.target;
      const handle = target.getAttribute ? target.getAttribute('data-handle') : null;
      if (handle) {
        activeDrag = handle;
        const coords = getSvgCoordinates(e);
        dragStart = coords;
        initialOrigin = { ...origin };
        renderProtractor();
        if (e.cancelable) e.preventDefault();
      }
    }

    function onPointerMove(e) {
      if (!activeDrag) return;
      if (e.cancelable) e.preventDefault();
      const coords = getSvgCoordinates(e);

      if (activeDrag === 'center') {
        // Move entire protractor
        const dx = coords.x - dragStart.x;
        const dy = coords.y - dragStart.y;
        origin.x = Math.max(50, Math.min(950, initialOrigin.x + dx));
        origin.y = Math.max(50, Math.min(650, initialOrigin.y + dy));
      } else if (activeDrag === 'ray1' || activeDrag === 'ray2') {
        // Calculate angle from origin to current pointer
        const dx = coords.x - origin.x;
        const dy = origin.y - coords.y; // Inverted SVG y
        let deg = (Math.atan2(dy, dx) * 180) / Math.PI;
        if (deg < 0) deg += 360;

        if (snap1Deg) {
          deg = Math.round(deg);
        }

        if (activeDrag === 'ray1') {
          angle1 = deg;
        } else {
          angle2 = deg;
        }
      }

      renderProtractor();
    }

    function onPointerUp() {
      if (activeDrag) {
        activeDrag = null;
        renderProtractor();
      }
    }

    // Modern Pointer Events + Touch Event fallback
    svg?.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);

    // Touch event fallback for mobile Safari
    svg?.addEventListener('touchstart', onPointerDown, { passive: false });
    window.addEventListener('touchmove', onPointerMove, { passive: false });
    window.addEventListener('touchend', onPointerUp);
    window.addEventListener('touchcancel', onPointerUp);

    // Dynamic Theme Change Listeners
    window.addEventListener('theme-change', () => {
      renderProtractor();
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      renderProtractor();
    });

    // Preset Angle buttons
    document.querySelectorAll('.preset-angle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetDeg = parseFloat(btn.getAttribute('data-preset') || '45');
        angle1 = 0;
        angle2 = targetDeg;
        renderProtractor();
      });
    });

    // Snap Checkbox
    snapCheckbox?.addEventListener('change', (e) => {
      snap1Deg = e.target.checked;
    });

    // Opacity Slider
    opacitySlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      opacity = val / 100;
      if (opacityLabel) opacityLabel.textContent = `${val}%`;
      renderProtractor();
    });

    // Scale Slider
    scaleSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      radius = (260 * val) / 100;
      if (scaleLabel) scaleLabel.textContent = `${val}%`;
      renderProtractor();
    });

    // Reset Button
    resetBtn?.addEventListener('click', () => {
      origin = { x: 500, y: mode === '360' ? 350 : 440 };
      angle1 = 0;
      angle2 = 45;
      radius = 260;
      if (scaleSlider) scaleSlider.value = '100';
      if (scaleLabel) scaleLabel.textContent = '100%';
      renderProtractor();
    });

    // 180 vs 360 mode buttons
    mode180Btn?.addEventListener('click', () => {
      mode = '180';
      origin = { x: 500, y: 440 };
      mode180Btn.className = 'px-4 py-2 text-xs font-semibold rounded-lg transition-all bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white shadow-sm';
      mode360Btn.className = 'px-4 py-2 text-xs font-semibold rounded-lg transition-all text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white';
      renderProtractor();
    });

    mode360Btn?.addEventListener('click', () => {
      mode = '360';
      origin = { x: 500, y: 350 };
      mode360Btn.className = 'px-4 py-2 text-xs font-semibold rounded-lg transition-all bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white shadow-sm';
      mode180Btn.className = 'px-4 py-2 text-xs font-semibold rounded-lg transition-all text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white';
      renderProtractor();
    });

    // Copy Angle Result
    copyBtn?.addEventListener('click', () => {
      const deg = getMeasuredAngle().toFixed(1);
      const rad = ((deg * Math.PI) / 180).toFixed(3);
      const textToCopy = `Measured Angle: ${deg}° (${rad} rad) - via aionlineprotractor.com`;
      navigator.clipboard.writeText(textToCopy).then(() => {
        if (copyBtnText) copyBtnText.textContent = 'Copied to Clipboard!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copy Angle Result';
        }, 2000);
      });
    });

    // Initial render
    renderProtractor();
  })();
</script>
