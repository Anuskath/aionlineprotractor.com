---
interface Props {
  initialMode?: '180' | '360';
  allowImageUpload?: boolean;
  pageTitle?: string;
  pageSubtitle?: string;
}

const {
  initialMode = '180',
  allowImageUpload = true,
  pageTitle = 'Precision Online Protractor',
  pageSubtitle = 'Drag the rays or vertex to measure any angle. Switch between 180° and 360° or upload an image to measure on drawings.',
} = Astro.props;
---

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
  <!-- Top Bar: Title & Mode Switcher -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-neutral-200 dark:border-neutral-800 pb-5">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">
        {pageTitle}
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-2xl">
        {pageSubtitle}
      </p>
    </div>

    <!-- Quick Mode Badges -->
    <div class="flex items-center gap-2 bg-neutral-100 dark:bg-neutral-900 p-1.5 rounded-xl border border-neutral-200 dark:border-neutral-800 self-start md:self-auto">
      <button
        id="mode-180-btn"
        class={`px-4 py-2 text-sm font-semibold rounded-lg transition-all ${
          initialMode === '180'
            ? 'bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white shadow-sm'
            : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        180° Semi-Circle
      </button>
      <button
        id="mode-360-btn"
        class={`px-4 py-2 text-sm font-semibold rounded-lg transition-all ${
          initialMode === '360'
            ? 'bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white shadow-sm'
            : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        360° Full Circle
      </button>
    </div>
  </div>

  <!-- Workspace Grid: Canvas + Inspector Dashboard -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left / Center: Interactive Canvas Container (col-span-8) -->
    <div class="lg:col-span-8 flex flex-col gap-3">
      <!-- Toolbar Header above canvas -->
      <div class="flex flex-wrap items-center justify-between gap-3 bg-white dark:bg-neutral-900 p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-xs">
        <div class="flex flex-wrap items-center gap-2">
          {allowImageUpload && (
            <label class="cursor-pointer inline-flex items-center gap-2 px-3.5 py-2 text-sm font-semibold rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors shadow-2xs">
              <svg class="w-4 h-4 text-neutral-600 dark:text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <span>Upload Image / PDF</span>
              <input id="image-loader" type="file" accept="image/*,application/pdf" class="hidden" />
            </label>
          )}

          {allowImageUpload && (
            <button
              id="open-camera-btn"
              type="button"
              class="cursor-pointer inline-flex items-center gap-2 px-3.5 py-2 text-sm font-semibold rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors shadow-2xs"
              title="Take a live photo with camera to measure an angle"
            >
              <svg class="w-4 h-4 text-neutral-600 dark:text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0118.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Take Photo</span>
            </button>
          )}
          <input id="camera-file-fallback" type="file" accept="image/*" capture="environment" class="hidden" />

          <!-- AI Auto-Detect Angle Button -->
          <button
            id="auto-detect-btn"
            type="button"
            class="hidden inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition-all active:scale-95 cursor-pointer"
            title="Scan diagram with AI and snap protractor onto detected angle"
          >
            <svg id="auto-detect-spinner" class="w-4 h-4 animate-spin hidden text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span id="auto-detect-icon">✨</span>
            <span id="auto-detect-text">AI Auto-Detect Angle</span>
          </button>

          <!-- PDF Multi-Page Navigation Bar -->
          <div id="pdf-controls" class="hidden items-center gap-1.5 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1.5 rounded-lg text-xs font-mono border border-neutral-200 dark:border-neutral-700">
            <button id="pdf-prev-btn" type="button" class="w-6 h-6 rounded flex items-center justify-center hover:bg-neutral-200 dark:hover:bg-neutral-700 font-bold" title="Previous page">◀</button>
            <span id="pdf-page-indicator" class="text-neutral-700 dark:text-neutral-300 font-semibold px-1">Page 1 / 1</span>
            <button id="pdf-next-btn" type="button" class="w-6 h-6 rounded flex items-center justify-center hover:bg-neutral-200 dark:hover:bg-neutral-700 font-bold" title="Next page">▶</button>
          </div>

          <button
            id="clear-img-btn"
            class="hidden text-sm font-medium text-rose-500 hover:text-rose-600 px-2.5 py-1.5 transition-colors"
          >
            Remove
          </button>
        </div>

        <div class="flex items-center gap-3">
          <!-- Snap Toggle -->
          <label class="flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 cursor-pointer select-none">
            <input id="snap-checkbox" type="checkbox" checked class="w-4 h-4 rounded text-neutral-900 dark:text-white focus:ring-0" />
            <span>Snap 1°</span>
          </label>

          <!-- Reset Button -->
          <button
            id="reset-protractor-btn"
            class="px-3 py-1.5 text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white rounded-lg border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
          >
            Reset
          </button>
        </div>
      </div>

      <!-- Main Interactive Protractor Area -->
      <div
        id="canvas-wrapper"
        class="relative w-full h-[360px] xs:h-[420px] sm:h-[500px] md:h-[560px] lg:h-[600px] rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 overflow-hidden shadow-xs select-none touch-none crosshair-cursor flex items-center justify-center"
      >
        <!-- Background Image layer -->
        <img
          id="uploaded-preview-img"
          alt="Measurement background"
          class="absolute inset-0 w-full h-full object-contain pointer-events-none hidden opacity-80"
        />

        <!-- Subtle Grid Background -->
        <div class="absolute inset-0 bg-[radial-gradient(#d4d4d4_1px,transparent_1px)] dark:bg-[radial-gradient(#262626_1px,transparent_1px)] [background-size:20px_20px] opacity-60 pointer-events-none"></div>

        <!-- AI Scanning Laser Sweep Bar -->
        <div id="ai-scanner-line" class="absolute inset-x-0 h-1 bg-gradient-to-r from-transparent via-emerald-400 to-transparent shadow-[0_0_15px_#10b981] pointer-events-none hidden transition-all duration-75"></div>

        <!-- AI Notification Status Toast -->
        <div id="ai-status-toast" class="absolute top-4 inset-x-4 sm:inset-x-auto sm:left-1/2 sm:-translate-x-1/2 bg-neutral-950/95 dark:bg-white text-white dark:text-neutral-950 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-full shadow-lg pointer-events-none hidden items-center gap-2 z-20 transition-all border border-emerald-500/30">
          <span id="ai-toast-icon">✨</span>
          <span id="ai-toast-msg">Angle auto-detected! Drag handles to fine-tune.</span>
        </div>

        <!-- SVG Interactive Protractor Container -->
        <svg
          id="protractor-svg"
          class="absolute w-full h-full"
          viewBox="0 0 1000 700"
          preserveAspectRatio="xMidYMid meet"
          style="touch-action: none;"
        >
          <!-- Dynamic Protractor Content rendered by client JS -->
          <g id="protractor-group"></g>
        </svg>

        <!-- Instructions Overlay Helper on Hover/Touch -->
        <div class="absolute bottom-3 left-3 right-3 sm:right-auto bg-neutral-900/85 dark:bg-black/90 backdrop-blur-xs text-white text-xs sm:text-sm px-3.5 py-2 rounded-lg pointer-events-none flex items-center gap-2 max-w-fit shadow-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0 animate-pulse"></span>
          <span class="hidden sm:inline">Drag Green handle for Ray 1 • Drag Blue handle for Ray 2 • Drag Center to move</span>
          <span class="sm:hidden">Drag Green/Blue rays or Center vertex</span>
        </div>
      </div>

      <!-- Quick Preset Angle Buttons -->
      <div class="flex items-center gap-2 p-3 rounded-xl bg-neutral-100/70 dark:bg-neutral-900/70 border border-neutral-200 dark:border-neutral-800 text-sm overflow-x-auto no-scrollbar">
        <span class="text-neutral-500 font-mono text-xs sm:text-sm font-semibold mr-1 shrink-0">Quick:</span>
        {['30°', '45°', '60°', '90°', '120°', '135°', '180°', '270°', '360°'].map((angle) => (
          <button
            data-preset={angle.replace('°', '')}
            class="preset-angle-btn shrink-0 px-3 py-1.5 min-h-[34px] font-mono text-xs sm:text-sm font-semibold rounded-lg bg-white dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500 hover:bg-neutral-50 dark:hover:bg-neutral-700 transition-colors"
          >
            {angle}
          </button>
        ))}
      </div>
    </div>

    <!-- Right: Readout Card & Geometry Breakdown (col-span-4) -->
    <div class="lg:col-span-4 flex flex-col gap-4">
      <!-- Main Live Metric Card -->
      <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 p-6 shadow-xs flex flex-col gap-5">
        <div class="flex items-center justify-between">
          <span class="text-sm font-mono font-semibold uppercase tracking-wider text-neutral-500">
            Measured Angle (θ)
          </span>
          <span
            id="angle-classification-badge"
            class="px-3 py-1 rounded-full text-xs sm:text-sm font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900"
          >
            Acute Angle
          </span>
        </div>

        <!-- Big Hero Angle Readout -->
        <div class="flex items-baseline gap-2">
          <span id="readout-deg" class="text-5xl sm:text-6xl font-black tracking-tight text-neutral-950 dark:text-white font-mono">
            45.0
          </span>
          <span class="text-3xl sm:text-4xl font-light text-neutral-400">°</span>
        </div>

        <!-- Secondary Angle Conversions -->
        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800 text-sm">
          <div class="bg-neutral-50 dark:bg-neutral-950 p-3.5 rounded-xl border border-neutral-100 dark:border-neutral-800/80">
            <span class="text-xs text-neutral-500 font-mono block mb-1">Radians</span>
            <span id="readout-rad" class="font-mono text-base font-bold text-neutral-900 dark:text-white">0.785 rad</span>
          </div>
          <div class="bg-neutral-50 dark:bg-neutral-950 p-3.5 rounded-xl border border-neutral-100 dark:border-neutral-800/80">
            <span class="text-xs text-neutral-500 font-mono block mb-1">Gradians</span>
            <span id="readout-grad" class="font-mono text-base font-bold text-neutral-900 dark:text-white">50.0 grad</span>
          </div>
        </div>

        <!-- Geometric Relations (Complementary, Supplementary, Reflex) -->
        <div class="space-y-2.5 pt-3 border-t border-neutral-100 dark:border-neutral-800">
          <h4 class="text-xs sm:text-sm font-mono uppercase font-semibold text-neutral-500">Angle Relationships</h4>
          
          <div class="flex items-center justify-between text-sm py-1">
            <span class="text-neutral-600 dark:text-neutral-400">Supplementary (180° - θ):</span>
            <span id="readout-supp" class="font-mono font-semibold text-neutral-900 dark:text-neutral-100">135.0°</span>
          </div>

          <div class="flex items-center justify-between text-sm py-1">
            <span class="text-neutral-600 dark:text-neutral-400">Complementary (90° - θ):</span>
            <span id="readout-comp" class="font-mono font-semibold text-neutral-900 dark:text-neutral-100">45.0°</span>
          </div>

          <div class="flex items-center justify-between text-sm py-1">
            <span class="text-neutral-600 dark:text-neutral-400">Reflex (360° - θ):</span>
            <span id="readout-reflex" class="font-mono font-semibold text-neutral-900 dark:text-neutral-100">315.0°</span>
          </div>

          <div class="flex items-center justify-between text-sm py-1">
            <span class="text-neutral-600 dark:text-neutral-400">Slope / Incline:</span>
            <span id="readout-slope" class="font-mono font-semibold text-neutral-900 dark:text-neutral-100">100.0%</span>
          </div>
        </div>

        <!-- Controls: Opacity & Scale -->
        <div class="space-y-3 pt-3 border-t border-neutral-100 dark:border-neutral-800 text-sm">
          <h4 class="font-mono text-xs sm:text-sm uppercase font-semibold text-neutral-500">Fine Adjustments</h4>
          
          <div>
            <div class="flex justify-between mb-1 text-xs sm:text-sm">
              <span class="text-neutral-600 dark:text-neutral-400">Protractor Opacity</span>
              <span id="opacity-label" class="font-mono font-medium">85%</span>
            </div>
            <input id="opacity-slider" type="range" min="20" max="100" value="85" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer" />
          </div>

          <div>
            <div class="flex justify-between mb-1 text-xs sm:text-sm">
              <span class="text-neutral-600 dark:text-neutral-400">Protractor Scale</span>
              <span id="scale-label" class="font-mono font-medium">100%</span>
            </div>
            <input id="scale-slider" type="range" min="60" max="140" value="100" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer" />
          </div>
        </div>
      </div>

      <!-- Copy & Export Actions -->
      <div class="flex gap-2">
        <button
          id="copy-angle-btn"
          class="flex-1 min-h-[46px] py-3 px-4 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-sm font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shadow-xs flex items-center justify-center gap-2 active:scale-98"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-btn-text">Copy Angle Result</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Camera Live Capture Modal -->
  <div
    id="camera-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-xs transition-all select-none"
  >
    <div class="relative w-full max-w-2xl bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-2xl overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-200 dark:border-neutral-800">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">📸</span>
          <div>
            <h3 class="font-bold text-sm sm:text-base text-neutral-900 dark:text-white">Take Photo to Measure Angle</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">Position the angle in the frame and click capture</p>
          </div>
        </div>
        <button
          id="close-camera-btn"
          type="button"
          class="w-8 h-8 rounded-lg flex items-center justify-center text-neutral-500 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer text-base font-bold"
          title="Close camera"
        >
          ✕
        </button>
      </div>

      <!-- Live Video Viewport -->
      <div class="relative w-full bg-black aspect-4/3 sm:aspect-16/10 flex items-center justify-center overflow-hidden">
        <video
          id="camera-video"
          autoplay
          playsinline
          muted
          class="w-full h-full object-cover"
        ></video>

        <!-- Centered Target Reticle / Alignment Circle -->
        <div class="absolute inset-0 pointer-events-none flex items-center justify-center opacity-40">
          <div class="w-24 h-24 border-2 border-dashed border-white/70 rounded-full flex items-center justify-center">
            <div class="w-2.5 h-2.5 bg-emerald-400 rounded-full shadow-[0_0_8px_#34d399]"></div>
          </div>
        </div>

        <!-- Camera Error Notice Fallback -->
        <div
          id="camera-error-msg"
          class="absolute inset-x-6 top-1/2 -translate-y-1/2 hidden bg-neutral-900/95 border border-rose-600/50 text-white text-sm p-6 rounded-2xl text-center space-y-3 z-10 shadow-xl"
        >
          <div class="text-2xl">📷</div>
          <p class="font-semibold text-rose-300">Camera access is blocked or unavailable in this browser</p>
          <p class="text-xs text-neutral-300">You can use your device's native camera photo picker instead.</p>
          <button
            id="camera-fallback-trigger-btn"
            type="button"
            class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold shadow-xs cursor-pointer inline-flex items-center gap-2"
          >
            <span>📱 Choose / Take Photo with Phone Camera</span>
          </button>
        </div>
      </div>

      <!-- Modal Footer Controls -->
      <div class="flex items-center justify-between px-6 py-4 bg-neutral-50 dark:bg-neutral-950 border-t border-neutral-200 dark:border-neutral-800">
        <!-- Switch Camera Button -->
        <button
          id="switch-camera-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-lg bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-300 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
          title="Switch front and rear cameras"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Flip Camera</span>
        </button>

        <!-- Big Shutter Button -->
        <button
          id="capture-photo-btn"
          type="button"
          class="w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white shadow-lg flex items-center justify-center transition-transform cursor-pointer border-4 border-white dark:border-neutral-900 ring-2 ring-emerald-500"
          title="Capture photo now"
        >
          <div class="w-6 h-6 rounded-full bg-white shadow-inner"></div>
        </button>

        <!-- Cancel Button -->
        <button
          id="cancel-camera-btn"
          type="button"
          class="px-3 py-2 text-xs font-semibold text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white cursor-pointer"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ initialMode }}>
  // Client-Side Protractor Interactive Engine
  (function () {
    let mode = initialMode || '180'; // '180' or '360'
    let snap1Deg = true;
    let opacity = 0.85;
    let radius = 260; // base protractor radius in SVG viewbox coordinates (1000 x 700)
    let origin = { x: 500, y: 440 }; // center vertex point
    let angle1 = 0; // base arm angle (Ray 1 in degrees)
    let angle2 = 45; // target arm angle (Ray 2 in degrees)
    let protractorRotation = 0; // whole protractor body rotation in degrees

    let activeDrag = null; // 'center' | 'ray1' | 'ray2' | 'body' | null
    let dragStart = { x: 0, y: 0 };
    let initialOrigin = { ...origin };

    const svg = document.getElementById('protractor-svg');
    const group = document.getElementById('protractor-group');
    const readoutDeg = document.getElementById('readout-deg');
    const readoutRad = document.getElementById('readout-rad');
    const readoutGrad = document.getElementById('readout-grad');
    const readoutSupp = document.getElementById('readout-supp');
    const readoutComp = document.getElementById('readout-comp');
    const readoutReflex = document.getElementById('readout-reflex');
    const readoutSlope = document.getElementById('readout-slope');
    const classificationBadge = document.getElementById('angle-classification-badge');

    const snapCheckbox = document.getElementById('snap-checkbox');
    const mode180Btn = document.getElementById('mode-180-btn');
    const mode360Btn = document.getElementById('mode-360-btn');
    const resetBtn = document.getElementById('reset-protractor-btn');
    const opacitySlider = document.getElementById('opacity-slider');
    const opacityLabel = document.getElementById('opacity-label');
    const scaleSlider = document.getElementById('scale-slider');
    const scaleLabel = document.getElementById('scale-label');
    const copyBtn = document.getElementById('copy-angle-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const imageLoader = document.getElementById('image-loader');
    const uploadedPreviewImg = document.getElementById('uploaded-preview-img');
    const clearImgBtn = document.getElementById('clear-img-btn');
    const autoDetectBtn = document.getElementById('auto-detect-btn');
    const autoDetectSpinner = document.getElementById('auto-detect-spinner');
    const autoDetectIcon = document.getElementById('auto-detect-icon');
    const autoDetectText = document.getElementById('auto-detect-text');
    const pdfControls = document.getElementById('pdf-controls');
    const pdfPrevBtn = document.getElementById('pdf-prev-btn');
    const pdfNextBtn = document.getElementById('pdf-next-btn');
    const pdfPageIndicator = document.getElementById('pdf-page-indicator');

    // Camera Live Capture Elements & State
    const openCameraBtn = document.getElementById('open-camera-btn');
    const cameraModal = document.getElementById('camera-modal');
    const closeCameraBtn = document.getElementById('close-camera-btn');
    const cancelCameraBtn = document.getElementById('cancel-camera-btn');
    const cameraVideo = document.getElementById('camera-video');
    const capturePhotoBtn = document.getElementById('capture-photo-btn');
    const switchCameraBtn = document.getElementById('switch-camera-btn');
    const cameraErrorMsg = document.getElementById('camera-error-msg');
    const cameraFileFallback = document.getElementById('camera-file-fallback');
    const cameraFallbackTriggerBtn = document.getElementById('camera-fallback-trigger-btn');

    let cameraStream = null;
    let currentFacingMode = 'environment'; // default to rear world-facing camera for physical objects

    let currentPdfDoc = null;
    let currentPdfPage = 1;
    let totalPdfPages = 1;

    // Dynamically load PDF.js from CDN if needed
    async function ensurePdfJs() {
      if (window.pdfjsLib) return window.pdfjsLib;
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = () => {
          if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
            resolve(window.pdfjsLib);
          } else {
            reject(new Error('PDF.js not found'));
          }
        };
        script.onerror = () => reject(new Error('Failed to load PDF library.'));
        document.head.appendChild(script);
      });
    }

    async function renderPdfPage(pageNum) {
      if (!currentPdfDoc || !uploadedPreviewImg) return;
      try {
        const page = await currentPdfDoc.getPage(pageNum);
        const viewport = page.getViewport({ scale: 2.0 });
        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        const ctx = canvas.getContext('2d');
        await page.render({ canvasContext: ctx, viewport }).promise;
        uploadedPreviewImg.src = canvas.toDataURL('image/png');
        uploadedPreviewImg.classList.remove('hidden');
        clearImgBtn?.classList.remove('hidden');
        autoDetectBtn?.classList.remove('hidden');

        if (pdfPageIndicator) {
          pdfPageIndicator.textContent = `Page ${pageNum} / ${totalPdfPages}`;
        }
      } catch (err) {
        console.error('Error rendering PDF page:', err);
      }
    }

    // Handle Image & PDF Loading
    imageLoader?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');

      if (isPdf) {
        try {
          if (autoDetectText) autoDetectText.textContent = 'Loading PDF...';
          autoDetectBtn?.classList.remove('hidden');

          const pdfLib = await ensurePdfJs();
          const fileData = await file.arrayBuffer();
          currentPdfDoc = await pdfLib.getDocument({ data: fileData }).promise;
          totalPdfPages = currentPdfDoc.numPages;
          currentPdfPage = 1;

          if (totalPdfPages > 1 && pdfControls) {
            pdfControls.classList.remove('hidden');
            pdfControls.classList.add('flex');
          } else if (pdfControls) {
            pdfControls.classList.add('hidden');
            pdfControls.classList.remove('flex');
          }

          await renderPdfPage(currentPdfPage);
          if (autoDetectText) autoDetectText.textContent = 'AI Auto-Detect Angle';
        } catch (err) {
          console.error(err);
          alert('Could not render PDF. Please upload a standard PDF or image file.');
        }
      } else {
        // Standard image file
        currentPdfDoc = null;
        if (pdfControls) {
          pdfControls.classList.add('hidden');
          pdfControls.classList.remove('flex');
        }

        const reader = new FileReader();
        reader.onload = (event) => {
          if (uploadedPreviewImg) {
            uploadedPreviewImg.src = event.target?.result;
            uploadedPreviewImg.classList.remove('hidden');
            clearImgBtn?.classList.remove('hidden');
            autoDetectBtn?.classList.remove('hidden');
          }
        };
        reader.readAsDataURL(file);
      }
    });

    // PDF Pagination
    pdfPrevBtn?.addEventListener('click', () => {
      if (currentPdfDoc && currentPdfPage > 1) {
        currentPdfPage--;
        renderPdfPage(currentPdfPage);
      }
    });

    pdfNextBtn?.addEventListener('click', () => {
      if (currentPdfDoc && currentPdfPage < totalPdfPages) {
        currentPdfPage++;
        renderPdfPage(currentPdfPage);
      }
    });

    function showStatusToast(message) {
      const toast = document.getElementById('ai-status-toast');
      const toastMsg = document.getElementById('ai-toast-msg');
      if (toast && toastMsg) {
        toastMsg.textContent = message;
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('flex');
        }, 5000);
      }
    }

    function applyLoadedImage(dataUrl, toastMessage) {
      currentPdfDoc = null;
      if (pdfControls) {
        pdfControls.classList.add('hidden');
        pdfControls.classList.remove('flex');
      }
      if (uploadedPreviewImg) {
        uploadedPreviewImg.src = dataUrl;
        uploadedPreviewImg.classList.remove('hidden');
        clearImgBtn?.classList.remove('hidden');
        autoDetectBtn?.classList.remove('hidden');
      }
      if (toastMessage) {
        showStatusToast(toastMessage);
      }
