---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../i18n/languages';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  currentPath?: string;
  lang?: string;
}

const {
  title = 'Online Protractor - Free Online Protractor Tool & Angle Finder',
  description = 'Free online protractor tool to measure angles in degrees and radians. Features 180° & 360° protractors, image and PDF upload measuring, and angle practice for students.',
  keywords = 'online protractor, online protractor tool, online protractor practice, online protractor tool for students, online protractor and angle maker, free online protractor, angle finder, angle finder tool, angle finder calculator, online protractor angle finder, online protractor 360',
  canonical = 'https://aionlineprotractor.com',
  robots = 'index, follow',
  jsonLd,
  currentPath = '/',
  lang = DEFAULT_LANGUAGE,
} = Astro.props;

const siteUrl = 'https://aionlineprotractor.com';
const canonicalUrl = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;

// Calculate root path for hreflang links
const pathSegments = currentPath.split('/').filter(Boolean);
const hasLocalePrefix = SUPPORTED_LANGUAGES.includes(pathSegments[0]) && pathSegments[0] !== DEFAULT_LANGUAGE;
const rawPath = hasLocalePrefix ? '/' + pathSegments.slice(1).join('/') : currentPath;
const normalizedPath = rawPath === '/' || rawPath === '' ? '/' : (rawPath.endsWith('/') ? rawPath : `${rawPath}/`);

// OG Locales mapping
const OG_LOCALES: Record<string, string> = {
  en: 'en_US',
  es: 'es_ES',
  pt: 'pt_BR',
  fr: 'fr_FR',
  de: 'de_DE',
  ja: 'ja_JP',
  ko: 'ko_KR',
  it: 'it_IT',
};
const currentOgLocale = OG_LOCALES[lang] || 'en_US';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4W3QWFP43D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4W3QWFP43D');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Alternate Links for International SEO -->
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${normalizedPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${normalizedPath}`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/es${normalizedPath === '/' ? '/' : normalizedPath}`} />
    <link rel="alternate" hreflang="pt" href={`${siteUrl}/pt${normalizedPath === '/' ? '/' : normalizedPath}`} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}/fr${normalizedPath === '/' ? '/' : normalizedPath}`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/de${normalizedPath === '/' ? '/' : normalizedPath}`} />
    <link rel="alternate" hreflang="ja" href={`${siteUrl}/ja${normalizedPath === '/' ? '/' : normalizedPath}`} />
    <link rel="alternate" hreflang="ko" href={`${siteUrl}/ko${normalizedPath === '/' ? '/' : normalizedPath}`} />
    <link rel="alternate" hreflang="it" href={`${siteUrl}/it${normalizedPath === '/' ? '/' : normalizedPath}`} />

    <!-- Open Graph / Social Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={currentOgLocale} />
    {Object.entries(OG_LOCALES).filter(([l]) => l !== lang).map(([_, locale]) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AI Online Protractor" />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#171717" />

    <!-- Anti-FOUC inline script for theme -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Structured Data JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])} />
    )}
  </head>
  <body class="flex flex-col min-h-screen bg-[#fafafa] dark:bg-black text-[#171717] dark:text-[#ededed] antialiased selection:bg-neutral-900 selection:text-white dark:selection:bg-white dark:selection:text-black">
    <Header currentPath={currentPath} lang={lang} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
